# Database connection URL (e.g., postgresql+asyncpg://...)
DATABASE_URL=

# Cloudinary credentials for document and asset uploads
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_TYPE=cloudinary

# Local AI Vector database path
CHROMA_DB_PATH=storage/chromadb

# Local Embedding configuration (BAAI/bge-small-en-v1.5, dimensions=384)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM routing gateway configuration
# Supported values: omniroute, openai, gemini, ollama, deepseek
LLM_PROVIDER=omniroute

# OmniRoute credentials (if LLM_PROVIDER is omniroute)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
DEEPSEEK_API_KEY=

# OpenAI credentials (if LLM_PROVIDER is openai)
OPENAI_API_KEY=

# Gemini credentials (if LLM_PROVIDER is gemini)
GEMINI_API_KEY=

# Ollama settings (if LLM_PROVIDER is ollama)
OLLAMA_API_URL=http://localhost:11434/api/generate

# AI Threshold parameters for column/header matching
SIMILARITY_THRESHOLD=0.90
LLM_THRESHOLD=0.70
