# =========================================================================
# PVAI Master Configuration Template
# =========================================================================

# -------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React / Vite)
# -------------------------------------------------------------------------
# API base URL for the backend service (excluding trailing slash)
VITE_API_URL=http://localhost:8000/api/v1

# -------------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI)
# -------------------------------------------------------------------------
# Environment Mode (development or production)
ENV=development

# Database connection URL (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:newpassword@localhost:5432/docgen_db

# Security & Session Authentication
# SECRET_KEY is used for general encryption, JWT_SECRET for signing access tokens
SECRET_KEY=7aef83b519c2f6d90d8a4362b2e8a1c97f6c3d9e8b7a6e5d4c3b2a10f9e8d7c6
JWT_SECRET=
JWT_ALGORITHM=HS256

# CORS config (Frontend Client URL)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary credentials for document and asset uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STORAGE_TYPE=cloudinary

# Local AI Vector database persistent directory path
CHROMA_DB_PATH=storage/chromadb

# Local Embedding model configuration (BAAI/bge-small-en-v1.5, dimensions=384)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM routing gateway configuration
# Supported values: omniroute, openai, gemini, ollama, deepseek
LLM_PROVIDER=omniroute

# DeepSeek credentials (if LLM_PROVIDER is deepseek)
DEEPSEEK_API_KEY=

# OmniRoute credentials (if LLM_PROVIDER is omniroute)
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# OpenAI credentials (if LLM_PROVIDER is openai)
OPENAI_API_KEY=

# Gemini credentials (if LLM_PROVIDER is gemini)
GEMINI_API_KEY=

# Ollama settings (if LLM_PROVIDER is ollama)
OLLAMA_API_URL=http://localhost:11434/api/generate

# AI Threshold parameters for column/header matching
SIMILARITY_THRESHOLD=0.90
LLM_THRESHOLD=0.70

# Redis & Caching Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TYPE=memory
CACHE_DEFAULT_TTL=300

# Feature Flags (Runtime toggle switches)
FEATURE_AI_PROVIDERS=True
FEATURE_EXPERIMENTAL_ENDPOINTS=False
FEATURE_BACKGROUND_WORKERS=True
FEATURE_METRICS=True
FEATURE_CACHE=True
FEATURE_COMPRESSION=True


